# Nomes das configurações do serviço Rafael Virtual (Cloudflare Worker).
# NUNCA coloque valores reais neste arquivo. Segredos ficam no painel da Cloudflare
# ou em GitHub → Settings → Secrets and variables → Actions.

# Segredo do Worker (obrigatório para a IA funcionar)
ANTHROPIC_API_KEY=coloque-a-chave-somente-no-painel

# Segredos do GitHub Actions para publicar o Worker automaticamente
CLOUDFLARE_API_TOKEN=token-com-permissao-Workers-Scripts-Edit
CLOUDFLARE_ACCOUNT_ID=id-da-conta-cloudflare

# Variáveis não secretas (já definidas em servidor/wrangler.toml; ajuste se quiser)
MODELO_IA=claude-haiku-5-5
ORIGENS_PERMITIDAS=https://premiumcarnes.com.br,https://www.premiumcarnes.com.br,https://rafaeltribioli.github.io
TIMEOUT_MS=20000
MAX_CHAMADAS_MODELO=6
MAX_TOKENS_RESPOSTA=2048
LIMITE_IP_10MIN=20
LIMITE_SESSAO_DIA=60
LIMITE_GLOBAL_DIA=3000

# Configuração pública do site (assistente/config.js): endereço do Worker depois de publicado
# endpoint: https://boi-premium-assistente.SEU-SUBDOMINIO.workers.dev
